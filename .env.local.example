# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# --- Supabase (Dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon public" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Email allow-list (SERVER-ONLY — do NOT prefix with NEXT_PUBLIC) ---
# Comma-separated Google emails allowed to sign in (app-layer check + friendly
# error). Keep in sync with the public.allowed_emails table in the DB, which is
# the hard gate that blocks non-listed accounts at sign-up.
ALLOWED_EMAILS=you@example.com,partner@example.com

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE=de-DE
NEXT_PUBLIC_CURRENCY=EUR
# IANA timezone used for "today" / "current month" date math (server-safe).
NEXT_PUBLIC_TIMEZONE=Europe/Berlin

# --- Optional: only if you later manage/delete auth users via the admin API ---
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
