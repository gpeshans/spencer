# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# --- Supabase (Dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon public" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Email allow-list (SERVER-ONLY — do NOT prefix with NEXT_PUBLIC) ---
# Comma-separated Google emails allowed to sign in (app-layer check + friendly
# error). Keep in sync with the public.allowed_emails table in the DB, which is
# the hard gate that blocks non-listed accounts at sign-up.
ALLOWED_EMAILS=you@example.com,partner@example.com

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE=de-DE
NEXT_PUBLIC_CURRENCY=EUR
# IANA timezone used for "today" / "current month" date math (server-safe).
NEXT_PUBLIC_TIMEZONE=Europe/Berlin

# --- Reports (SERVER-ONLY — do NOT prefix with NEXT_PUBLIC) ---
# Anthropic API key for the report engine (console.anthropic.com -> API Keys).
# `npm run reports:smoke` uses it against a throwaway local database (Docker).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# The reporting login (migration 0008) through the Supavisor pooler in
# transaction mode, port 6543. Reports run their SQL with it, and
# `npm run reports:model:live` checks the semantic model against it.
# Keep ?sslmode=require: without it the driver connects in plain text, so both
# refuse the URL. A password with characters like @ : / # ? must be
# percent-encoded.
REPORTS_DATABASE_URL=postgres://reports_login.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# The secret key (Dashboard -> Project Settings -> API Keys -> sb_secret_...).
# The server writes report runs and their logs with it; people only read their own.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Signs the household scope of every report query. Use exactly the value stored
# in Vault as reports_scope_key (migration 0008), at least 32 characters.
REPORTS_SCOPE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
